config {
  type: "view",
  schema: "staging",
  tags: ["staging"],
  description: "Customers: one row per customer (latest version), typed and with clean text fields.",
  columns: {
    customer_id: "Business key of the customer.",
    first_name: "First name, trimmed and title-cased.",
    last_name: "Last name, trimmed and title-cased.",
    email: "Email in lower case.",
    city: "City of the latest known address.",
    region: "Region of the latest known address.",
    country: "ISO 3166-1 alpha-2 country code.",
    signup_date: "Date the customer created the account.",
    updated_at: "Timestamp of the latest change in the source system."
  },
  assertions: {
    uniqueKey: ["customer_id"],
    nonNull: ["customer_id", "email", "signup_date"]
  }
}

-- The source sends a new row every time a customer changes (e.g. moves city):
-- keep only the latest version of each customer.
SELECT
  SAFE_CAST(customer_id AS INT64) AS customer_id,
  ${constants.cleanText("first_name")} AS first_name,
  ${constants.cleanText("last_name")} AS last_name,
  LOWER(TRIM(email)) AS email,
  TRIM(city) AS city,
  TRIM(region) AS region,
  UPPER(TRIM(country)) AS country,
  SAFE_CAST(signup_date AS DATE) AS signup_date,
  SAFE_CAST(updated_at AS TIMESTAMP) AS updated_at
FROM ${ref("customers")}
WHERE customer_id IS NOT NULL
QUALIFY ROW_NUMBER() OVER (
  PARTITION BY customer_id
  ORDER BY SAFE_CAST(updated_at AS TIMESTAMP) DESC
) = 1
