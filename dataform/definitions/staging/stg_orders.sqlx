config {
  type: "view",
  schema: "staging",
  tags: ["staging"],
  description: "Order headers, typed, with the order date and a revenue flag.",
  columns: {
    order_id: "Business key of the order.",
    customer_id: "Customer who placed the order.",
    order_ts: "Timestamp of the order (UTC).",
    order_date: "Calendar date of the order in the store time zone.",
    channel: "Sales channel: web, app or marketplace.",
    payment_method: "Payment method used.",
    status: "Order status: delivered, shipped, cancelled or returned.",
    is_revenue: "TRUE when the status counts as revenue (delivered or shipped).",
    shipping_cost: "Shipping cost charged to the customer (EUR)."
  },
  assertions: {
    uniqueKey: ["order_id"],
    nonNull: ["order_id", "customer_id", "order_ts", "status"],
    rowConditions: [
      `status IN (${constants.sqlList(constants.VALID_STATUSES)})`,
      "shipping_cost >= 0"
    ]
  }
}

SELECT
  SAFE_CAST(order_id AS INT64) AS order_id,
  SAFE_CAST(customer_id AS INT64) AS customer_id,
  SAFE_CAST(order_ts AS TIMESTAMP) AS order_ts,
  DATE(SAFE_CAST(order_ts AS TIMESTAMP), "Europe/Madrid") AS order_date,
  LOWER(TRIM(channel)) AS channel,
  LOWER(TRIM(payment_method)) AS payment_method,
  LOWER(TRIM(status)) AS status,
  LOWER(TRIM(status)) IN (${constants.sqlList(constants.REVENUE_STATUSES)}) AS is_revenue,
  SAFE_CAST(shipping_cost AS NUMERIC) AS shipping_cost
FROM ${ref("orders")}
WHERE order_id IS NOT NULL
