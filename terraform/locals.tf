locals {
  labels = merge(var.labels, {
    app         = "sales-pipeline"
    environment = var.environment
    managed_by  = "terraform"
  })

  is_prod     = var.environment == "prod"
  git_enabled = var.git_remote_url != ""
  raw_bucket  = coalesce(var.raw_bucket_name, "${var.project_id}-raw-${var.environment}")

  # Raw tables: every column lands as STRING and is typed in the staging layer,
  # so a bad value in a source file never breaks the load.
  raw_tables = {
    customers   = ["customer_id", "first_name", "last_name", "email", "city", "region", "country", "signup_date", "updated_at"]
    products    = ["product_id", "product_name", "category", "unit_price", "unit_cost", "is_active"]
    orders      = ["order_id", "customer_id", "order_ts", "channel", "payment_method", "status", "shipping_cost"]
    order_items = ["order_item_id", "order_id", "product_id", "quantity", "unit_price", "discount_pct"]
  }

  # BigQuery datasets, one per layer of the model.
  datasets = {
    raw                 = "Landing layer: external tables over the raw GCS bucket (all STRING)."
    staging             = "Staging layer: typed, cleaned and deduplicated views, one per source table."
    intermediate        = "Intermediate layer: reusable joins and business logic."
    marts               = "Marts layer: star schema (dimensions and facts) for BI tools."
    dataform_assertions = "Data quality assertions generated by Dataform."
  }

  services = [
    "bigquery.googleapis.com",
    "dataform.googleapis.com",
    "iam.googleapis.com",
    "secretmanager.googleapis.com",
    "storage.googleapis.com",
  ]
}
